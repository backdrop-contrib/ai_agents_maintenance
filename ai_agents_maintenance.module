<?php


/**
 * @file
 * Cron-backed maintenance queue with approval gates.
 */

/**
 * Implements hook_permission().
 */
function ai_agents_maintenance_permission() {
  return [
    'administer ai maintenance' => [
      'title' => t('Administer AI maintenance'),
      'description' => t('Review, approve, and execute maintenance candidates.'),
    ],
  ];
}

