/**
 * Return all registered maintenance task definitions.
 *
 * Invokes hook_ai_agents_maintenance_task_info() across all modules and
 * allows alteration via hook_ai_agents_maintenance_task_info_alter().
 *
 * @param string|null $task_type
 *   Optional task type machine name to look up.
 *
 * @return array
 *   Array of task definitions or single task definition array, keyed by task type.
 */
function ai_agents_maintenance_get_task_info($task_type = NULL) {
  $tasks = &backdrop_static(__FUNCTION__);

  if (!isset($tasks)) {
    $tasks = module_invoke_all('ai_agents_maintenance_task_info');
    backdrop_alter('ai_agents_maintenance_task_info', $tasks);
  }

  if ($task_type !== NULL) {
    return isset($tasks[$task_type]) ? $tasks[$task_type] : NULL;
  }

  return $tasks;
}

