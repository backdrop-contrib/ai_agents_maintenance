/**
 * Implements hook_cron().
 */
function ai_agents_maintenance_cron() {
  $config = config('ai_agents_maintenance.settings');

  if (!$config->get('cron_enabled')) {
    return;
  }

  $interval = (int) ($config->get('cron_interval') ?: 86400);
  $last_run = (int) $config->get('cron_last_run');
  if (REQUEST_TIME - $last_run < $interval) {
    return;
  }

  $apply_limit = (int) ($config->get('apply_batch_size') ?: 5);
  $queued = 0;

  // Run each configured assistant or agent.
  $scheduled = $config->get('scheduled_assistants');
  if (!empty($scheduled) && is_array($scheduled)) {
    global $user;
    $original_user = $user;
    $session_state = backdrop_save_session();
    backdrop_save_session(FALSE);
    $cron_uid = (int) ($config->get('cron_uid') ?: 1);
    if ($cron_uid === 1) {
      watchdog('ai_agents_maintenance', 'Cron running with superuser (UID 1). To adhere to least-privilege security standards, configure a dedicated service account in AI Maintenance settings.', [], WATCHDOG_NOTICE);
    }
    $user = user_load($cron_uid) ?: user_load(1);

    try {
      foreach ($scheduled as $entry) {
        $assistant_id = !empty($entry['assistant_id']) ? $entry['assistant_id'] : '';
        $agent_id = !empty($entry['agent_id']) ? $entry['agent_id'] : '';
        if (empty($entry['enabled']) || (empty($assistant_id) && empty($agent_id))) {
          continue;
        }
        try {
          $prompt = !empty($entry['prompt']) ? $entry['prompt'] : 'Run your maintenance scan now and queue any proposals with the maintenance_propose_change tool.';
          $result = NULL;

          if (!empty($assistant_id) && module_exists('ai_assistants')) {
            $result = ai_assistants_send($assistant_id, $prompt);
          }
          elseif (!empty($agent_id) && module_exists('ai_agents')) {
            $result = ai_agents_run($agent_id, $prompt);
          }

          if (!empty($result['error'])) {
            watchdog('ai_agents_maintenance', 'Scheduled task @id error: @err', ['@id' => ($assistant_id ?: $agent_id), '@err' => $result['error']], WATCHDOG_WARNING);
          }
          elseif (!empty($result['status']) && $result['status'] === 'needs_approval') {
            // A backing agent hit a write tool that pauses for live approval.
            watchdog('ai_agents_maintenance', 'Scheduled task @id paused for tool approval during cron; give its agents the maintenance_propose_change tool instead of direct write tools.', ['@id' => ($assistant_id ?: $agent_id)], WATCHDOG_WARNING);
          }
          else {
            $queued++;
          }
        }
        catch (Exception $e) {
          watchdog('ai_agents_maintenance', 'Scheduled task @id threw an exception during cron: @msg', ['@id' => ($assistant_id ?: $agent_id), '@msg' => $e->getMessage()], WATCHDOG_ERROR);
        }
      }
    }
    finally {
      $user = $original_user;
      backdrop_save_session($session_state);
    }
  }

  $applied = ai_agents_maintenance_apply_approved_items($apply_limit);
  $config->set('cron_last_run', REQUEST_TIME)->save();

  watchdog('ai_agents_maintenance', 'Cron: ran @queued maintenance task(s), applied @applied item(s).', [
    '@queued' => $queued,
    '@applied' => $applied,
  ]);
}

/**
 * Return a unique run identifier.
 */
function ai_agents_maintenance_run_id() {
  return REQUEST_TIME . '-' . substr(hash('sha256', mt_rand() . microtime(TRUE)), 0, 8);
}

/**
 * Implements hook_ai_tools().
 *
 * maintenance_propose_change uses operation 'propose' (not 'write') on
 * purpose: it only inserts a row into the review queue, and marking it
 * 'write' would make ai_agents pause unattended cron runs for a live
 * approval no human is present to give. The queue itself is the approval
 * gate — nothing touches site content until an admin approves the row.
 */
function ai_agents_maintenance_ai_tools() {
  $tasks = ai_agents_maintenance_get_task_info();
  $task_keys = array_keys($tasks);
  $task_descriptions = [];
  foreach ($tasks as $key => $info) {
    $task_descriptions[] = $key . ' (' . $info['label'] . ' - ' . $info['description'] . ')';
  }

  return [
    'maintenance_propose_change' => [
      'definition' => [
        'type' => 'function',
        'function' => [
          'name' => 'maintenance_propose_change',
          'description' => 'Queue a maintenance proposal for human review on the AI Maintenance queue. Nothing changes on the site until an administrator approves the proposal. Supported task types: ' . implode('; ', $task_descriptions),
          'parameters' => [
            'type' => 'object',
            'properties' => [
              'task_type' => [
                'type' => 'string',
                'enum' => $task_keys,
                'description' => 'Maintenance task type. Available: ' . implode(', ', $task_keys),
              ],
              'entity_type' => [
                'type' => 'string',
                'description' => 'Target entity type, e.g. file or node (leave empty or "site" for site-wide recommendations).',
              ],
              'entity_id' => [
                'type' => 'integer',
                'description' => 'Target entity id (fid for files, nid for nodes, 0 for site-wide recommendations).',
              ],
              'bundle' => [
                'type' => 'string',
                'description' => 'Target bundle or field name (e.g. field_tags or image).',
              ],
              'before_value' => [
                'type' => 'string',
                'description' => 'Current value, when known. Checked before apply to guard against concurrent edits.',
              ],
              'after_value' => [
                'type' => 'string',
                'description' => 'Proposed new value, or the recommended action text.',
              ],
              'reason' => [
                'type' => 'string',
                'description' => 'Why this change is proposed — shown to the reviewing administrator.',
              ],
            ],
            'required' => ['task_type', 'after_value', 'reason'],
          ],
        ],
      ],
      'execute' => 'ai_agents_maintenance_execute_propose_change',
      'operation' => 'propose',
      'destructive' => FALSE,
      'permission' => 'administer ai maintenance',
    ],
    'maintenance_list_proposals' => [
      'definition' => [
        'type' => 'function',
        'function' => [
          'name' => 'maintenance_list_proposals',
          'description' => 'List queued maintenance proposals. Use before proposing to avoid duplicates, or to report queue state.',
          'parameters' => [
            'type' => 'object',
            'properties' => [
              'status' => [
                'type' => 'string',
                'enum' => ['pending', 'approved', 'applied', 'rejected', 'failed'],
                'description' => 'Filter by status. Omit for all.',
              ],
              'limit' => [
                'type' => 'integer',
                'description' => 'Maximum rows to return (default 20, max 50).',
              ],
            ],
          ],
        ],
      ],
      'execute' => 'ai_agents_maintenance_execute_list_proposals',
      'operation' => 'read',
      'destructive' => FALSE,
      'permission' => 'administer ai maintenance',
    ],
  ];
}

/**
 * Tool executor: queue one maintenance proposal.
 */
function ai_agents_maintenance_execute_propose_change(array $args) {
  $task_type = isset($args['task_type']) ? trim((string) $args['task_type']) : '';
  $entity_type = isset($args['entity_type']) ? trim((string) $args['entity_type']) : '';
  $entity_id = isset($args['entity_id']) ? (int) $args['entity_id'] : 0;
  $bundle = isset($args['bundle']) ? trim((string) $args['bundle']) : '';
  $before_value = isset($args['before_value']) ? trim((string) $args['before_value']) : '';
  $after_value = isset($args['after_value']) ? trim((string) $args['after_value']) : '';
  $reason = isset($args['reason']) ? trim((string) $args['reason']) : '';

  $tasks = ai_agents_maintenance_get_task_info();
  if (empty($task_type) || !isset($tasks[$task_type])) {
    return ['error' => 'Invalid or unsupported task_type: ' . $task_type];
  }
  if ($after_value === '' || $reason === '') {
    return ['error' => 'after_value and reason are required.'];
  }

  $task_info = $tasks[$task_type];
  $expected_entity_type = !empty($task_info['entity_type']) ? $task_info['entity_type'] : '';

  if ($expected_entity_type !== '') {
    if ($entity_type === '') {
      $entity_type = $expected_entity_type;
    }
    elseif ($entity_type !== $expected_entity_type) {
      return ['error' => "task_type '$task_type' requires entity_type '$expected_entity_type'."];
    }
    if (!$entity_id) {
      return ['error' => "entity_id is required for task_type '$task_type'."];
    }
  }

  $source_fid = 0;
  if ($task_type === 'file_alt_from_usage') {
    $file = file_load($entity_id);
    if (!$file) {
      return ['error' => "File $entity_id was not found."];
    }
    $bundle = !empty($file->type) ? $file->type : ($bundle ?: 'image');
    $source_fid = (int) $file->fid;
    if ($before_value === '') {
      $before_value = ai_agents_maintenance_current_file_alt($file);
    }
  }
  elseif ($task_type === 'node_publish_status') {
    $node = node_load($entity_id);
    if (!$node) {
      return ['error' => "Node $entity_id was not found."];
    }
    if (empty($bundle)) {
      $bundle = $node->type;
    }
    if ($before_value === '') {
      $before_value = !empty($node->status) ? 'published' : 'unpublished';
    }
  }
  elseif ($task_type === 'node_field_update') {
    $node = node_load($entity_id);
    if (!$node) {
      return ['error' => "Node $entity_id was not found."];
    }
    if (empty($bundle)) {
      return ['error' => 'bundle (target field name) is required for node_field_update.'];
    }
    if ($before_value === '' && isset($node->{$bundle})) {
      $lang = !empty($node->language) ? $node->language : LANGUAGE_NONE;
      if (!empty($node->{$bundle}[$lang][0]['value'])) {
        $before_value = $node->{$bundle}[$lang][0]['value'];
      }
      elseif (!empty($node->{$bundle}[LANGUAGE_NONE][0]['value'])) {
        $before_value = $node->{$bundle}[LANGUAGE_NONE][0]['value'];
      }
    }
  }
  elseif ($task_type === 'taxonomy_term_assign') {
    $node = node_load($entity_id);
    if (!$node) {
      return ['error' => "Node $entity_id was not found."];
    }
    if (empty($bundle)) {
      $bundle = 'field_tags';
    }
  }

  if (ai_agents_maintenance_queue_exists($task_type, $entity_type, $entity_id, $source_fid, $after_value)) {
    return [
      'status' => 'duplicate',
      'message' => 'An equivalent proposal is already queued for this target.',
    ];
  }

  ai_agents_maintenance_queue_insert([
    'task_type' => $task_type,
    'entity_type' => $entity_type,
    'entity_id' => $entity_id,
    'bundle' => $bundle,
    'source_fid' => $source_fid,
    'before_value' => $before_value,
    'after_value' => $after_value,
    'reason' => $reason,
    'status' => 'pending',
    'run_id' => ai_agents_maintenance_run_id(),
    'created' => REQUEST_TIME,
    'updated' => REQUEST_TIME,
    'approved_by' => 0,
    'approved_at' => 0,
    'applied_at' => 0,
    'error_message' => '',
  ]);

  return [
    'status' => 'queued',
    'task_type' => $task_type,
    'entity_type' => $entity_type,
    'entity_id' => $entity_id,
    'message' => 'Proposal queued for administrator review.',
  ];
}

/**
 * Tool executor: list queued maintenance proposals.
 */
function ai_agents_maintenance_execute_list_proposals(array $args) {
  $status = isset($args['status']) ? trim((string) $args['status']) : '';
  $limit = isset($args['limit']) ? (int) $args['limit'] : 20;
  $limit = max(1, min(50, $limit));

  $items = ai_agents_maintenance_get_queue_items($limit, $status);
  $rows = [];
  foreach ($items as $item) {
    $rows[] = [
      'qid' => (int) $item['qid'],
      'status' => $item['status'],
      'task_type' => $item['task_type'],
      'entity_type' => $item['entity_type'],
      'entity_id' => (int) $item['entity_id'],
      'after_value' => $item['after_value'],
      'reason' => $item['reason'],
      'created' => (int) $item['created'],
    ];
  }

  return [
    'count' => count($rows),
    'items' => $rows,
  ];
}

/**
 * Scan for alt text candidates and queue them for review.
 */
function ai_agents_maintenance_scan_alt_candidates($limit = 10, $run_id = '') {
  module_load_include('inc', 'ai_alt_tools', 'includes/alt.tools');
  if (!function_exists('ai_alt_tools_execute_find_images_missing_alt') || !function_exists('ai_alt_tools_find_alt_from_usage')) {
    return ['queued' => 0, 'skipped' => 0];
  }

  $limit = max(1, (int) $limit);
  $run_id = $run_id !== '' ? $run_id : ai_agents_maintenance_run_id();
  $result = ai_alt_tools_execute_find_images_missing_alt([
    'limit' => $limit,
    'include_inline' => FALSE,
  ]);
  if (!empty($result['error']) || empty($result['images']) || !is_array($result['images'])) {
    return ['queued' => 0, 'skipped' => 0];
  }

  $queued = 0;
  $skipped = 0;

  foreach ($result['images'] as $row) {
    if (empty($row['fid'])) {
      continue;
    }

    $file = file_load((int) $row['fid']);
    if (!$file || strpos((string) $file->filemime, 'image/') !== 0) {
      continue;
    }

    if (ai_agents_maintenance_queue_exists('file_alt_from_usage', 'file', $file->fid, $file->fid)) {
      $skipped++;
      continue;
    }

    $seed = ai_alt_tools_find_alt_from_usage($file);
    if ($seed === FALSE || empty($seed['alt_text'])) {
      $skipped++;
      continue;
    }

    $candidate = ai_agents_maintenance_build_alt_candidate($file, $seed, $run_id);
    if (empty($candidate)) {
      $skipped++;
      continue;
    }

    ai_agents_maintenance_queue_insert($candidate);
    $queued++;
  }

  if ($queued || $skipped) {
    watchdog('ai_agents_maintenance', 'Scan run @run_id queued @queued candidate(s) and skipped @skipped item(s).', [
      '@run_id' => $run_id,
      '@queued' => $queued,
      '@skipped' => $skipped,
    ]);
  }

  return [
    'queued' => $queued,
    'skipped' => $skipped,
  ];
}

/**
 * Build one queued maintenance candidate for an image file.
 */
function ai_agents_maintenance_build_alt_candidate($file, array $seed, $run_id) {
  $source = !empty($seed['source']) && is_array($seed['source']) ? $seed['source'] : [];
  $alt_text = trim((string) $seed['alt_text']);
  if ($alt_text === '') {
    return [];
  }

  $reason = t('Found existing alt text in file usage.');
  if (!empty($source['type']) && !empty($source['id'])) {
    $reason = t('Found existing alt text in @type @id.', [
      '@type' => $source['type'],
      '@id' => $source['id'],
    ]);
    if ($source['type'] === 'node') {
      $node = node_load((int) $source['id']);
      if ($node) {
        $reason = t('Found existing alt text in node "@title".', [
          '@title' => $node->title,
        ]);
      }
    }
  }

  return [
    'task_type' => 'file_alt_from_usage',
    'entity_type' => 'file',
    'entity_id' => (int) $file->fid,
    'bundle' => !empty($file->type) ? $file->type : 'image',
    'source_fid' => (int) $file->fid,
    'before_value' => ai_agents_maintenance_current_file_alt($file),
    'after_value' => $alt_text,
    'reason' => (string) $reason,
    'status' => 'pending',
    'run_id' => (string) $run_id,
    'created' => REQUEST_TIME,
    'updated' => REQUEST_TIME,
    'approved_by' => 0,
    'approved_at' => 0,
    'applied_at' => 0,
    'error_message' => '',
  ];
}

/**
 * Load the current global alt text for a file.
 */
function ai_agents_maintenance_current_file_alt($file) {
  if (function_exists('ai_alt_tools_get_file_alt_text')) {
    return ai_alt_tools_get_file_alt_text($file);
  }
  $alt_field = function_exists('image_entity_alt_field_name') ? image_entity_alt_field_name() : 'field_alt';
  if (!empty($file->{$alt_field}[LANGUAGE_NONE][0]['value'])) {
    return trim($file->{$alt_field}[LANGUAGE_NONE][0]['value']);
  }
  if (!empty($file->alt)) {
    return trim($file->alt);
  }
  return '';
}

/**
 * Check whether an equivalent queue row already exists.
 */
function ai_agents_maintenance_queue_exists($task_type, $entity_type, $entity_id, $source_fid = 0, $after_value = NULL) {
  $active_statuses = ['pending', 'queued', 'approved'];
  $query = db_select('ai_agents_maintenance_queue', 'q')
    ->fields('q', ['qid'])
    ->condition('task_type', $task_type)
    ->condition('entity_type', $entity_type)
    ->condition('entity_id', (int) $entity_id)
    ->condition('status', $active_statuses, 'IN')
    ->range(0, 1);
  if (!empty($source_fid)) {
    $query->condition('source_fid', (int) $source_fid);
  }
  if ($after_value !== NULL) {
    $query->condition('after_value', $after_value);
  }
  return (bool) $query->execute()->fetchField();
}

/**
 * Insert a queue row.
 */
function ai_agents_maintenance_queue_insert(array $values) {
  db_insert('ai_agents_maintenance_queue')
    ->fields($values)
    ->execute();
}

/**
 * Return queue items.
 *
 * @param int $limit
 *   Max items to return.
 * @param string|array $status
 *   Single status string or array of status strings.
 *
 * @return array
 *   Queue rows keyed by qid.
 */
function ai_agents_maintenance_get_queue_items($limit = 50, $status = '') {
  $query = db_select('ai_agents_maintenance_queue', 'q')
    ->fields('q')
    ->orderBy('created', 'DESC')
    ->range(0, (int) $limit);
  if (!empty($status)) {
    if (is_array($status)) {
      $query->condition('status', $status, 'IN');
    }
    else {
      $query->condition('status', $status);
    }
  }
  return $query->execute()->fetchAllAssoc('qid', PDO::FETCH_ASSOC);
}

/**
 * Return queue counts by status.
 */
function ai_agents_maintenance_queue_counts() {
  $query = db_select('ai_agents_maintenance_queue', 'q')
    ->fields('q', ['status']);
  $query->addExpression('COUNT(*)', 'count');
  $query->groupBy('status');

  $counts = [];
  foreach ($query->execute() as $row) {
    $counts[$row->status] = (int) $row->count;
  }
  return $counts;
}

/**
 * Return recent queue rows.
 */
function ai_agents_maintenance_recent_items($limit = 20) {
  return ai_agents_maintenance_get_queue_items($limit);
}

/**
 * Mark queue rows with a new status.
 */
function ai_agents_maintenance_update_queue_status(array $qids, $status, $user_id = 0, $error_message = '') {
  if (empty($qids)) {
    return 0;
  }

  // Build the full field set before the single fields() call —
  // UpdateQuery::fields() replaces the field array, it does not merge, so
  // chaining a second call silently drops the status change.
  $fields = [
    'status'        => $status,
    'updated'       => REQUEST_TIME,
    'error_message' => $status === 'failed' ? $error_message : '',
    'approved_by'   => $status === 'approved' ? (int) $user_id : 0,
    'approved_at'   => $status === 'approved' ? REQUEST_TIME : 0,
    'applied_at'    => $status === 'applied'  ? REQUEST_TIME : 0,
  ];

  return db_update('ai_agents_maintenance_queue')
    ->fields($fields)
    ->condition('qid', $qids, 'IN')
    ->execute();
}

/**
 * Apply approved queue rows.
 */
function ai_agents_maintenance_apply_approved_items($limit = 5) {
  $items = ai_agents_maintenance_get_queue_items($limit, 'approved');
  $applied = 0;

  foreach ($items as $item) {
    if (ai_agents_maintenance_apply_queue_item($item)) {
      $applied++;
    }
  }

  return $applied;
}

/**
 * Apply one queue row via pluggable task handler.
 *
 * @param array $item
 *   Queue row array.
 *
 * @return bool
 *   TRUE on successful apply, FALSE on failure.
 */
function ai_agents_maintenance_apply_queue_item(array $item) {
  if (empty($item['qid'])) {
    return FALSE;
  }

  $task_info = ai_agents_maintenance_get_task_info($item['task_type']);
  if (!$task_info || empty($task_info['apply_callback']) || !is_callable($task_info['apply_callback'])) {
    ai_agents_maintenance_update_queue_status([(int) $item['qid']], 'failed', 0, 'Unsupported or uncallable task handler for: ' . $item['task_type']);
    return FALSE;
  }

  $error_message = '';
  $callback = $task_info['apply_callback'];
  try {
    $success = call_user_func_array($callback, [&$item, &$error_message]);
  }
  catch (Exception $e) {
    $success = FALSE;
    $error_message = $e->getMessage();
  }

  if ($success) {
    db_update('ai_agents_maintenance_queue')
      ->fields([
        'status' => 'applied',
        'updated' => REQUEST_TIME,
        'applied_at' => REQUEST_TIME,
        'error_message' => '',
      ])
      ->condition('qid', (int) $item['qid'])
      ->execute();

    watchdog('ai_agents_maintenance', 'Applied queued maintenance item @qid (@type on @entity_type:@entity_id).', [
      '@qid' => $item['qid'],
      '@type' => $item['task_type'],
      '@entity_type' => $item['entity_type'],
      '@entity_id' => $item['entity_id'],
    ]);
    return TRUE;
  }
  else {
    db_update('ai_agents_maintenance_queue')
      ->fields([
        'status' => 'failed',
        'updated' => REQUEST_TIME,
        'error_message' => $error_message !== '' ? $error_message : 'Apply failed.',
      ])
      ->condition('qid', (int) $item['qid'])
      ->execute();
    return FALSE;
  }
}

/**
 * Task handler: Apply file alt text from usage.
 */
function ai_agents_maintenance_task_apply_file_alt(array &$item, &$error = '') {
  $file = file_load((int) $item['entity_id']);
  if (!$file) {
    $error = 'File no longer exists.';
    return FALSE;
  }

  $current = ai_agents_maintenance_current_file_alt($file);
  $expected_before = isset($item['before_value']) ? trim((string) $item['before_value']) : '';
  $new_value = isset($item['after_value']) ? trim((string) $item['after_value']) : '';

  if ($new_value === '') {
    $error = 'Queued alt text was empty.';
    return FALSE;
  }

  if ($current !== '' && $current !== $new_value && $current !== $expected_before) {
    $error = 'Current alt text changed before apply.';
    return FALSE;
  }

  if (function_exists('ai_alt_tools_set_file_alt_text')) {
    ai_alt_tools_set_file_alt_text($file, $new_value);
  }
  else {
    $alt_field = function_exists('image_entity_alt_field_name') ? image_entity_alt_field_name() : 'field_alt';
    $file->{$alt_field} = [
      LANGUAGE_NONE => [
        [
          'value' => $new_value,
        ],
      ],
    ];
    file_save($file);
  }

  return TRUE;
}

/**
 * Task handler: Advisory recommendation.
 */
function ai_agents_maintenance_task_apply_recommendation(array &$item, &$error = '') {
  // Advisory only: applying records that the recommendation was reviewed and accepted.
  return TRUE;
}

/**
 * Task handler: Node publication status.
 */
function ai_agents_maintenance_task_apply_node_status(array &$item, &$error = '') {
  $node = node_load((int) $item['entity_id']);
  if (!$node) {
    $error = 'Node no longer exists.';
    return FALSE;
  }

  $expected_before = isset($item['before_value']) ? strtolower(trim((string) $item['before_value'])) : '';
  $new_value = isset($item['after_value']) ? strtolower(trim((string) $item['after_value'])) : '';

  $target_status = ($new_value === '1' || $new_value === 'published' || $new_value === 'publish') ? 1 : 0;
  $expected_status = ($expected_before === '1' || $expected_before === 'published' || $expected_before === 'publish') ? 1 : ($expected_before === '' ? NULL : 0);

  if ($expected_status !== NULL && (int) $node->status !== $expected_status) {
    $error = 'Current node publication status changed before apply.';
    return FALSE;
  }

  $node->status = $target_status;
  node_save($node);
  return TRUE;
}

/**
 * Task handler: Node field update.
 */
function ai_agents_maintenance_task_apply_node_field(array &$item, &$error = '') {
  $node = node_load((int) $item['entity_id']);
  if (!$node) {
    $error = 'Node no longer exists.';
    return FALSE;
  }

  $field_name = !empty($item['bundle']) ? trim((string) $item['bundle']) : '';
  if ($field_name === '') {
    $error = 'Target field name must be specified in the bundle attribute.';
    return FALSE;
  }

  $expected_before = isset($item['before_value']) ? trim((string) $item['before_value']) : '';
  $new_value = isset($item['after_value']) ? trim((string) $item['after_value']) : '';

  $lang = !empty($node->language) ? $node->language : LANGUAGE_NONE;
  $current_value = '';
  if (!empty($node->{$field_name}[$lang][0]['value'])) {
    $current_value = trim($node->{$field_name}[$lang][0]['value']);
  }
  elseif (!empty($node->{$field_name}[LANGUAGE_NONE][0]['value'])) {
    $current_value = trim($node->{$field_name}[LANGUAGE_NONE][0]['value']);
    $lang = LANGUAGE_NONE;
  }

  if ($expected_before !== '' && $current_value !== '' && $current_value !== $expected_before && $current_value !== $new_value) {
    $error = 'Current field value changed before apply.';
    return FALSE;
  }

  $node->{$field_name}[$lang][0]['value'] = $new_value;
  node_save($node);
  return TRUE;
}

/**
 * Task handler: Assign taxonomy term to node.
 */
function ai_agents_maintenance_task_apply_taxonomy_term(array &$item, &$error = '') {
  $node = node_load((int) $item['entity_id']);
  if (!$node) {
    $error = 'Node no longer exists.';
    return FALSE;
  }

  $field_name = !empty($item['bundle']) ? trim((string) $item['bundle']) : 'field_tags';
  $term_input = isset($item['after_value']) ? trim((string) $item['after_value']) : '';
  if ($term_input === '') {
    $error = 'Term name or ID was empty.';
    return FALSE;
  }

  $tid = 0;
  if (is_numeric($term_input)) {
    $tid = (int) $term_input;
  }
  else {
    $field_info = field_info_field($field_name);
    $vocab_name = !empty($field_info['settings']['allowed_values'][0]['vocabulary']) ? $field_info['settings']['allowed_values'][0]['vocabulary'] : 'tags';
    $terms = taxonomy_get_term_by_name($term_input, $vocab_name);
    if (!empty($terms)) {
      $term = reset($terms);
      $tid = (int) $term->tid;
    }
    else {
      $term = new TaxonomyTerm([
        'name' => $term_input,
        'vocabulary' => $vocab_name,
      ]);
      taxonomy_term_save($term);
      $tid = (int) $term->tid;
    }
  }

  if (!$tid) {
    $error = 'Could not locate or create taxonomy term.';
    return FALSE;
  }

  $lang = !empty($node->language) ? $node->language : LANGUAGE_NONE;
  $existing_tids = [];
  if (!empty($node->{$field_name}[$lang])) {
    foreach ($node->{$field_name}[$lang] as $item_val) {
      if (!empty($item_val['tid'])) {
        $existing_tids[] = (int) $item_val['tid'];
      }
    }
  }
  elseif (!empty($node->{$field_name}[LANGUAGE_NONE])) {
    $lang = LANGUAGE_NONE;
    foreach ($node->{$field_name}[LANGUAGE_NONE] as $item_val) {
      if (!empty($item_val['tid'])) {
        $existing_tids[] = (int) $item_val['tid'];
      }
    }
  }

  if (in_array($tid, $existing_tids, TRUE)) {
    return TRUE;
  }

  $node->{$field_name}[$lang][] = ['tid' => $tid];
  node_save($node);
  return TRUE;
}
